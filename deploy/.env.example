# Copy to deploy/.env on the VPS. Never commit .env.

# Host paths (outside the repository)
MODELS_DIR=/opt/averon/models
POC_DATA_DIR=/opt/averon/poc-data

# Speech-to-text model: file name inside MODELS_DIR, plus registry ID (docs/models.md)
STT_MODEL=ggml-small-q5_1.bin
STT_MODEL_ID=whisper-small-q5_1

# Translation model: file name inside MODELS_DIR, plus registry ID (docs/models.md)
LLM_MODEL=Qwen3-4B-Q4_K_M.gguf
LLM_MODEL_ID=qwen3-4b-q4km
LLM_CTX_SIZE=2048

# Resource limits (design D3; adjust after measuring the baseline in poc/reports/baseline.md)
INFERENCE_THREADS=2
WHISPER_MEM_LIMIT=1536m
LLAMA_MEM_LIMIT=3584m

# Runner timeouts in seconds (design D5; tune after the benchmark)
STT_TIMEOUT=90
TRANSLATION_TIMEOUT=60
TOTAL_TIMEOUT=180
